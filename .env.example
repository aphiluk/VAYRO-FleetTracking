# Optional local host ports. Copy to .env to override.
WEB_PORT=3000
GATEWAY_PORT=3001
AUTH_PORT=3002
USER_PORT=3003

# Local dev only. Replace both before any shared or real deployment.
POSTGRES_PASSWORD=vayro_dev_only_change_me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Set to true when the web app is served over HTTPS (marks session cookies Secure).
COOKIE_SECURE=false
